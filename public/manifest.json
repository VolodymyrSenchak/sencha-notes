{
  "manifest_version": 3,
  "name": "SenNotes",
  "version": "2.0.0.0",
  "description": "Unlimited notes in your toolbar. Organize them into sections, find anything with instant search, and keep it all on your device.",
  "background": {
    "service_worker": "./background.js"
  },
  "permissions": [],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Open SenNotes"
    }
  },
  "author": "Volodymyr Senchak",
  "homepage_url": "https://github.com/VolodymyrSenchak",
  "short_name": "SenNotes",
  "action": {
    "default_popup": "index.html",
    "default_title": "SenNotes",
    "default_icon": {
      "16": "/icons/icon-16.png",
      "32": "/icons/icon-32.png",
      "48": "/icons/icon-48.png",
      "128": "/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "/icons/icon-16.png",
    "32": "/icons/icon-32.png",
    "48": "/icons/icon-48.png",
    "128": "/icons/icon-128.png"
  }
}